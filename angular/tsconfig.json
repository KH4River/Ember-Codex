/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    // The repository root, not this folder. `paths` below maps `@/*` at both
    // ./src/app/* and ../shared/*, so every shared/ file this project imports
    // lives outside angular/. Left unset, the editor pins rootDir to the
    // workspace and TS6059 fires on shared/db/DatabasePort.ts and its
    // siblings -- which are imported from app code and have been since
    // b49c1f3. Set here rather than in each derived config so there is one
    // place to look. Both configs' `outDir` are unused: the Angular builder
    // emits through esbuild to angular/dist, so this moves no output.
    "rootDir": "..",
    "paths": {
      "@/*": ["./src/app/*", "../shared/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
