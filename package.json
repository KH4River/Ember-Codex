{
  "name": "ember-codex",
  "version": "0.0.0",
  "private": true,
  "main": "electron/build/app.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ng": "ng",
    "electron": "npm run build:electron && concurrently --kill-others \"cd angular && ng serve\" \"electron .\"",
    "build:electron": "tsc -p electron/tsconfig.json",
    "cap:add:android": "npm run build && cap add android",
    "cap:open:android": "cap open android",
    "cap:run:android": "npm run build && cap run android",
    "cap:sync": "npm run build && cap sync",
    "serve": "cd angular && ng serve",
    "build": "cd angular && ng build",
    "generate:migrations": "node tools/generate-migrations.mjs",
    "watch": "cd angular && ng build --watch --configuration development",
    "test": "cd angular && ng test"
  },
  "author": {
    "name": "KH4River",
    "email": "camposdavidmartinez@gmail.com"
  },
  "contributors": [
    {
      "name": "Shoonkey",
      "email": "shoonkey.dev@gmail.com"
    },
    {
      "name": "KH4River",
      "email": "camposdavidmartinez@gmail.com"
    }
  ],
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.4.3",
    "@capacitor/core": "^8.5.3",
    "concurrently": "^9.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "electron": "^44.7.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "@parcel/watcher": false
  }
}
