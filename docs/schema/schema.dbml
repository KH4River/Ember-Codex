  checks {
    `unlock_level BETWEEN 1 AND 20`
  }
}

Table subclass_armour_type {
  subclass_id integer [not null]
  armour_type text [not null]
  indexes {
    (subclass_id, armour_type) [pk]
  }
  checks {
    `armour_type IN ('light', 'medium', 'heavy', 'shield')`
  }
}

Table subclass_skill {
  subclass_id integer [not null]
  skill_id integer [not null]
  indexes {
    (subclass_id, skill_id) [pk]
  }
}

Table subclass_tool {
  subclass_id integer [not null]
  tool_id integer [not null]
  indexes {
    (subclass_id, tool_id) [pk]
  }
}

Table tool {
  id integer [pk, not null]
  slug text [not null, unique]
  name text [not null]
  is_artisan integer [not null, default: 0]
  checks {
    `is_artisan IN (0, 1)`
  }
}

Table weapon {
  item_id integer [pk, not null]
  category_id integer [not null]
  damage_dice text [not null]
  damage_type_id integer [not null]
  versatile_dice text
  attack_bonus integer [not null, default: 0]
  damage_bonus integer [not null, default: 0]
  thrown_range integer
  ammunition_id integer
  mastery_property_id integer
  checks {
    `attack_bonus >= 0`
    `damage_bonus >= 0`
    `thrown_range IS NULL OR thrown_range > 0`
  }
}

Table weapon_category {
  id integer [pk, not null]
  code text [not null, unique]
  checks {
    `code IN ('simple_melee', 'simple_ranged', 'martial_melee', 'martial_ranged')`
  }
}

Table weapon_property {
  id integer [pk, not null]
  code text [not null, unique]
  checks {
    `code IN ('finesse', 'versatile', 'heavy', 'light', 'loading', 'reach', 'thrown', 'two_handed', 'ammunition', 'improvised')`
  }
}

Table weapon_property_map {
  item_id integer [not null]
  property_id integer [not null]
  indexes {
    (item_id, property_id) [pk]
  }
}

Table xp_threshold {
  level integer [pk, not null]
  xp_required integer [not null]
  checks {
    `level BETWEEN 1 AND 20`
    `xp_required >= 0`
  }
}

